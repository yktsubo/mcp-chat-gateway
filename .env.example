# Copy to .env.local for local development. On Vercel, set the same names as Environment Variables.

# --- App ---
NEXTAUTH_URL=http://localhost:3000
# Encryption key for the login session and the MCP tokens stored in Redis: openssl rand -base64 32
# Changing it requires all users to sign in and connect again
NEXTAUTH_SECRET=

# --- Login (Okta OIDC app linked to the AI agent) ---
# e.g. https://your-org.okta.com
OKTA_ISSUER=
OKTA_CLIENT_ID=
# Set either the client secret or the AI agent private key (JWK as one-line JSON; enables private_key_jwt)
OKTA_CLIENT_SECRET=
OKTA_AI_AGENT_PRIVATE_KEY=
# AI agent ID used for XAA (defaults to OKTA_CLIENT_ID)
OKTA_AI_AGENT_ID=

# --- MCP servers (JSON array; see README) ---
# e.g. [{"name":"gateway","label":"Okta Agent Gateway","url":"https://your-org.gateway.okta.com/mcp/servers/xxx","description":"Jira and Confluence","auth":"xaa","scope":"gateway:connect"},{"name":"notion","label":"Notion","url":"https://mcp.notion.com/mcp","description":"Notion pages and databases"}]
MCP_SERVERS=

# --- Token storage (Upstash Redis) ---
# Set automatically when Upstash Redis is connected on Vercel. Locally: vercel env pull .env.local
# If unset, data is kept in memory (local development only)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Chat rate limit per user per minute (default 10; disabled without Redis) ---
CHAT_RATE_LIMIT_PER_MINUTE=

# --- Maximum conversation size per chat request (default 2097152 bytes = 2 MB and 200 messages; Vercel limit is 4.5 MB) ---
CHAT_MAX_REQUEST_BYTES=
CHAT_MAX_MESSAGES=

# --- System prompt (optional) ---
SYSTEM_PROMPT=

# --- LLM: Azure OpenAI if AZURE_OPENAI_DEPLOYMENT is set, otherwise Claude ---
ANTHROPIC_API_KEY=
# Default claude-haiku-5-5 (e.g. claude-sonnet-5-5, claude-opus-5-5)
ANTHROPIC_MODEL=
# Only for organization keys not bound to a workspace
ANTHROPIC_WORKSPACE_ID=
AZURE_API_KEY=
# https://<this>.openai.azure.com
AZURE_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=
